{
  "expo": {
    "name": "TierNerd",
    "slug": "tiernerd",
    "version": "0.7.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tiernerd",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#EFF7FF",
          "dark": {
            "backgroundColor": "#15263F"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maxwellward.tiernerd",
      "appleTeamId": "48TY2FP59S",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
