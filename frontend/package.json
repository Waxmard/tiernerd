{
  "name": "tiernerd-rn",
  "version": "0.7.1",
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:staged": "biome check --write --no-errors-on-unmatched",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test src/services/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.12.1",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "nativewind": "^4.2.7",
    "react": "19.1.4",
    "react-native": "0.81.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.15",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "patch-package": "^8.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "postcss": "^8.5.10",
    "shell-quote": "^1.8.4",
    "uuid": "^13.0.1"
  },
  "private": true
