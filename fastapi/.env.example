# Application Environment
APP_ENV=production

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS RDS Database Configuration
# Format: postgresql+asyncpg://username:password@rds-endpoint:5432/database_name
# Example: postgresql+asyncpg://postgres:mypassword@mydb.abc123.us-east-1.rds.amazonaws.com:5432/tiernerd
DATABASE_URL=postgresql+asyncpg://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/your-database-name

# CORS Configuration
# Comma-separated list of allowed origins
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS_STR=https://yourdomain.com

# Optional regex matching origins that can't be listed explicitly.
# Dev example (loopback + RFC1918 hosts on the Metro web port):
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+):8081$

# Logging
LOG_LEVEL=INFO

# Optional: SSL/TLS for RDS (append to DATABASE_URL if needed)
# ?ssl=require&sslmode=require
